<!doctype html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>In lệnh điều chuyển hàng đặc biệt</title>
  <script>document.documentElement.dataset.theme=localStorage.getItem('transferOrder.theme.v1')||'light'</script>
  <link rel="preload" href="assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="styles.css?v=20260827-hd2" />
</head>
<body>
  <div id="loginOverlay" class="login-overlay no-print">
    <section id="authSection" class="auth-panel">
      <img class="auth-logo" src="assets/img/logo_agribank.png" alt="Agribank" onerror="this.style.display='none'" />
      <h2 class="auth-title">Đăng nhập Agribank Thanh Hóa</h2>
      <div class="auth-subtitle">IN LỆNH ĐIỀU CHUYỂN</div>
      <form id="loginForm" class="auth-grid">
        <input id="loginUsername" autocomplete="username" placeholder="Email hoặc User LDAP" required />
        <div class="password-field"><input id="loginPassword" type="password" autocomplete="current-password" placeholder="Mật khẩu" required /><button type="button" class="password-toggle" id="passwordToggle">Hiện</button></div>
        <button class="btn primary login-submit" type="submit">Đăng nhập</button>
      </form>
      <div id="loginError" class="status info" role="status" aria-live="polite"></div>
      <button type="button" class="theme-toggle auth-theme-btn" data-theme-toggle title="Chuyển giao diện sáng/tối">☀️ Sáng</button>
    </section>
  </div>

  <div class="app-shell locked" id="appShell">
    <aside class="sidebar no-print">
      <div class="brand-block">
        <div class="brand-mark">A</div>
        <div>
          <div class="brand-name">Lệnh điều chuyển</div>
          <div class="brand-user">Agribank Thọ Xuân</div>
        </div>
      </div>
      <div class="side-section-head">
        <div>
          <div class="section-kicker">HỒ SƠ</div>
          <h2>Điều chuyển</h2>
        </div>
        <button type="button" id="refreshRecordsBtn" class="tool-btn" title="Tải lại"><span>↻</span></button>
      </div>
      <input id="recordSearch" type="search" placeholder="Tìm bản ghi..." />
      <nav class="side-nav">
        <button class="side-item active" data-screen="formScreen">Lập lệnh</button>
        <button class="side-item" data-screen="recordsScreen">Bản ghi đã lưu</button>
        <button class="side-item" data-screen="peopleScreen">Quản lý nhân sự</button>
      </nav>
      <button type="button" class="side-collapse" data-theme-toggle>Giao diện</button>
    </aside>

    <div class="main-col">
      <header class="topbar no-print">
        <div class="crumb"><span class="crumb-icon">▧</span><span class="crumb-current">Điều chuyển</span><span>/ Hồ sơ</span></div>
        <div class="top-actions">
          <span id="currentUserName" class="user-label"></span>
          <button type="button" class="btn secondary" data-screen-target="formScreen">+ Tạo lệnh</button>
          <button type="button" id="logoutBtn" class="btn secondary">Đăng xuất</button>
        </div>
      </header>

      <main class="workspace-col">
        <section id="formScreen" class="screen active">
          <div class="page-heading no-print">
            <div>
              <div class="section-kicker">HỒ SƠ ĐIỀU CHUYỂN</div>
              <h1>Lập lệnh điều chuyển</h1>
              <p>Nhập thông tin lệnh, chọn nhân sự và kiểm tra bản in A4.</p>
            </div>
          </div>
          <div class="grid">
            <form id="orderForm" class="card form-card">
              <div class="section-title">
                <div>
                  <div class="section-kicker">THÔNG TIN LỆNH</div>
                  <h2>Thông tin lệnh</h2>
                </div>
                <span>Nháp</span>
              </div>
              <div class="two-col">
                <label>Nơi đi<select id="fromBranch" required></select></label>
                <label>Nơi đến<select id="toBranch" required></select></label>
                <label>Biển số xe<input id="vehiclePlate" placeholder="VD: 36A-708.79" /></label>
                <label>Số văn bản<input id="docNo" placeholder="          /QĐ-NHNo.TX-KTNQ" /></label>
                <label>Ngày văn bản<input id="docDate" type="date" /></label>
                <label>Người áp tải<select id="escortId" required></select></label>
                <label>Lái xe<select id="driverId" required></select></label>
                <label>Bảo vệ<select id="guardId" required></select></label>
                <label>Người đề nghị<select id="requesterId"></select></label>
                <label>Người nhập<select id="receiverId"></select></label>
                <div class="full goods-builder" id="goodsBuilder"></div>
              </div>
              <div class="actions">
                <button type="button" id="resetOrderBtn" class="btn secondary">Làm mới</button>
                <button type="button" id="printBtn" class="btn primary">In lệnh</button>
              </div>
            </form>
            <aside class="card preview-card no-print">
              <div class="section-title">
                <div>
                  <div class="section-kicker">XEM TRƯỚC</div>
                  <h2>Tóm tắt lệnh</h2>
                </div>
                <span>Live</span>
              </div>
              <div id="miniPreview" class="mini-preview"></div>
            </aside>
          </div>
          <article id="printArea" class="print-paper"></article>
        </section>

        <section id="recordsScreen" class="screen">
          <div class="page-heading no-print">
            <div>
              <div class="section-kicker">HỒ SƠ</div>
              <h1>Bản ghi đã lưu</h1>
              <p>Mở lại, in PDF hoặc quản lý lệnh đã lưu.</p>
            </div>
          </div>
          <div class="card list-card records-card">
            <div class="section-title">
              <div>
                <div class="section-kicker">DANH SÁCH</div>
                <h2>Bản ghi đã lưu</h2>
              </div>
              <span id="recordsCount">0 bản ghi</span>
            </div>
            <div class="record-toolbar record-toolbar-filters">
              <input id="recordSearch" placeholder="Tìm số văn bản, nơi đi, nơi đến..." />
              <input id="recordFromDate" type="date" title="Từ ngày" />
              <input id="recordToDate" type="date" title="Đến ngày" />
              <select id="recordEscortFilter"><option value="">Tất cả người áp tải</option></select>
              <select id="recordUserFilter"><option value="">Tất cả user lập lệnh</option></select>
              <button type="button" id="refreshRecordsBtn" class="btn secondary">Tải lại</button>
            </div>
            <div id="recordsList" class="records-list"></div>
          </div>
        </section>

        <section id="peopleScreen" class="screen">
          <div class="page-heading no-print">
            <div>
              <div class="section-kicker">DANH BẠ</div>
              <h1>Quản lý nhân sự</h1>
              <p>Danh sách nhân sự dùng trong lệnh điều chuyển.</p>
            </div>
          </div>
          <div class="grid people-grid">
            <form id="personForm" class="card form-card">
              <div class="section-title">
                <div>
                  <div class="section-kicker">NHÂN SỰ</div>
                  <h2>Thêm / sửa nhân sự</h2>
                </div>
                <span id="editBadge">Thêm mới</span>
              </div>
              <input type="hidden" id="personId" />
              <div class="two-col">
                <label>Họ tên<input id="personName" required placeholder="VD: Đỗ Tuấn Minh" /></label>
                <label>Vai trò<select id="personRole"><option value="escort">Người áp tải</option><option value="driver">Lái xe</option><option value="guard">Bảo vệ</option><option value="requester">Người đề nghị</option><option value="receiver">Người nhập</option></select></label>
                <label>Chức vụ<input id="personTitle" required placeholder="VD: Trưởng phòng KTNQ" /></label>
                <label>Giới tính / xưng hô<select id="personGender"><option value="Ông">Ông</option><option value="Bà">Bà</option></select></label>
                <label>Số CCCD<input id="personCccd" maxlength="12" placeholder="12 số" /></label>
                <label>Ngày cấp<input id="personIssueDate" placeholder="DD/MM/YYYY" /></label>
                <label>Nơi cấp<input id="personIssuePlace" placeholder="Cục CSQLHC về TTXH" /></label>
                <label>User<input id="personUser" placeholder="VD: THXLXUAN" /></label>
              </div>
              <div class="actions">
                <button type="button" id="resetPersonBtn" class="btn secondary">Làm mới</button>
                <button class="btn primary">Lưu nhân sự</button>
              </div>
            </form>
            <div class="card list-card">
              <div class="section-title">
                <div>
                  <div class="section-kicker">DANH SÁCH</div>
                  <h2>Nhân sự</h2>
                </div>
                <span id="peopleCount"></span>
              </div>
              <div id="peopleList" class="people-list"></div>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
  <script src="app.js?v=20260812-acqt-introduction-always"></script>
</body>
</html>