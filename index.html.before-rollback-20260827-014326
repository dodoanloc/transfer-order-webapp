<!doctype html>
<html lang="vi" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>In lệnh điều chuyển hàng đặc biệt</title>
  <script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('transferOrder.theme.v1')||'dark')}catch(_){}</script>
  <link rel="preload" href="assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="assets/fonts/inter-var.css">
  <link rel="stylesheet" href="styles.css?v=20260826-sidebar1-subtitle">
</head>
<body>
  <div id="loginOverlay" class="login-overlay no-print">
    <section id="authSection" class="auth-panel">
      <div class="detail-head">
        <img class="auth-logo" src="assets/img/logo_agribank.png" alt="Agribank">
        <h2>Đăng nhập Agribank Thanh Hóa</h2>
        <div class="auth-subtitle">IN LỆNH ĐIỀU CHUYỂN</div>
      </div>
      <form id="loginForm" class="search-grid auth-grid">
        <input id="loginUsername" autocomplete="username" placeholder="Email hoặc User LDAP" required />
        <div class="pw-field">
          <input id="loginPassword" type="password" autocomplete="current-password" placeholder="Mật khẩu" required />
          <button type="button" class="pw-toggle" data-pw-toggle aria-label="Hiện mật khẩu">Hiện</button>
        </div>
        <button class="btn primary" type="submit">Đăng nhập</button>
      </form>
      <button type="button" class="btn secondary theme-toggle login-theme-toggle" data-theme-toggle title="Chuyển giao diện sáng/tối">◐ Giao diện</button>
      <div id="loginError" class="status info" role="status" aria-live="polite"></div>
    </section>
  </div>

  <aside class="sidebar no-print" id="appSidebar" hidden>
    <div class="brand-block">
      <img class="brand-logo" src="assets/img/logo_agribank.png" alt="Agribank">
      <div class="brand-text">
        <div class="brand-name">Lệnh điều chuyển</div>
        <div class="brand-user" id="currentUserName"></div>
      </div>
    </div>
    <div class="side-section-head">
      <span class="section-kicker">MENU</span>
    </div>
    <nav class="side-nav" role="tablist">
      <button class="side-item tab active" data-screen="formScreen" role="tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Lập lệnh
      </button>
      <button class="side-item tab" data-screen="recordsScreen" role="tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Bản ghi đã lưu
      </button>
      <button class="side-item tab" data-screen="peopleScreen" role="tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Quản lý nhân sự
      </button>
    </nav>
    <div class="side-collapse">
      <button class="btn secondary side-btn theme-toggle" data-theme-toggle title="Chuyển giao diện sáng/tối">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        Giao diện
      </button>
      <button type="button" id="logoutBtn" class="btn secondary side-btn logout-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Đăng xuất
      </button>
    </div>
  </aside>

  <div class="app-shell locked" id="appShell">
    <header class="hero no-print">
      <div>
        <span class="eyebrow">AGRIBANK THỌ XUÂN</span>
        <h1>Lệnh điều chuyển kiêm giấy uỷ quyền áp tải</h1>
        <p class="subtitle">Nhập thông tin, chọn nhân sự từ danh sách CCCD và in mẫu A4.</p>
      </div>
      <div class="header-right"></div>
    </header>

    <main>
      <section id="formScreen" class="screen active">
        <div class="grid">
          <form id="orderForm" class="card form-card">
            <div class="section-title">
              <h2>Thông tin lệnh</h2>
              <span>Làm mới mỗi lần truy cập</span>
            </div>
            <div class="two-col">
              <label>Nơi đi<select id="fromBranch" required></select></label>
              <label>Nơi đến<select id="toBranch" required></select></label>
              <label>Biển số xe<input id="vehiclePlate" placeholder="VD: 36A-708.79" /></label>
              <label>Số văn bản<input id="docNo" placeholder="          /QĐ-NHNo.TX-KTNQ" /></label>
              <label>Ngày văn bản<input id="docDate" type="date" /></label>
              <label>Người áp tải<select id="escortId" required></select></label>
              <label>Lái xe<select id="driverId" required></select></label>
              <label>Bảo vệ<select id="guardId" required></select></label>
              <label>Người đề nghị<select id="requesterId"></select></label>
              <label>Người nhập<select id="receiverId"></select></label>
              <div class="full goods-builder" id="goodsBuilder"></div>
            </div>
            <div class="actions">
              <button type="button" id="resetOrderBtn" class="btn secondary">Làm mới</button>
              <button type="button" id="printBtn" class="btn primary">In lệnh</button>
            </div>
          </form>

          <aside class="card preview-card">
            <div class="section-title"><h2>Xem nhanh</h2><span>Preview</span></div>
            <div id="miniPreview" class="mini-preview"></div>
          </aside>
        </div>

        <article id="printArea" class="print-paper"></article>
      </section>

      <section id="recordsScreen" class="screen">
        <div class="card list-card records-card">
          <div class="section-title"><h2>Bản ghi đã lưu</h2><span id="recordsCount">0 bản ghi</span></div>
          <div class="record-toolbar record-toolbar-filters">
            <input id="recordSearch" placeholder="Tìm số văn bản, nơi đi, nơi đến..." />
            <input id="recordFromDate" type="date" title="Từ ngày" />
            <input id="recordToDate" type="date" title="Đến ngày" />
            <select id="recordEscortFilter"><option value="">Tất cả người áp tải</option></select>
            <select id="recordUserFilter"><option value="">Tất cả user lập lệnh</option></select>
            <button type="button" id="refreshRecordsBtn" class="btn secondary">Tải lại</button>
          </div>
          <div id="recordsList" class="records-list"></div>
        </div>
      </section>

      <section id="peopleScreen" class="screen">
        <div class="grid people-grid">
          <form id="personForm" class="card form-card">
            <div class="section-title"><h2>Thêm / sửa nhân sự</h2><span id="editBadge">Thêm mới</span></div>
            <input type="hidden" id="personId" />
            <div class="two-col">
              <label>Họ tên<input id="personName" required placeholder="VD: Đỗ Tuấn Minh" /></label>
              <label>Vai trò<select id="personRole"><option value="escort">Người áp tải</option><option value="driver">Lái xe</option><option value="guard">Bảo vệ</option><option value="requester">Người đề nghị</option><option value="receiver">Người nhập</option></select></label>
              <label>Chức vụ<input id="personTitle" required placeholder="VD: Trưởng phòng KTNQ" /></label>
              <label>Giới tính / xưng hô<select id="personGender"><option value="Ông">Ông</option><option value="Bà">Bà</option></select></label>
              <label>Số CCCD<input id="personCccd" maxlength="12" placeholder="12 số" /></label>
              <label>Ngày cấp<input id="personIssueDate" placeholder="DD/MM/YYYY" /></label>
              <label>Nơi cấp<input id="personIssuePlace" placeholder="Cục CSQLHC về TTXH" /></label>
              <label>User<input id="personUser" placeholder="VD: THXLXUAN" /></label>
            </div>
            <div class="actions">
              <button type="button" id="resetPersonBtn" class="btn secondary">Làm mới</button>
              <button class="btn primary">Lưu nhân sự</button>
            </div>
          </form>
          <div class="card list-card">
            <div class="section-title"><h2>Danh sách nhân sự</h2><span id="peopleCount"></span></div>
            <div id="peopleList" class="people-list"></div>
          </div>
        </div>
      </section>
    </main>
  </div>
  <script src="app.js?v=20260826-sidebar1"></script>
</body>
</html>
