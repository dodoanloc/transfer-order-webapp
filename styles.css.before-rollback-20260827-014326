/* ============================================================
   In lệnh điều chuyển hàng đặc biệt (8892)
   Design system: Frappe Helpdesk clone 100% (chuẩn Sếp Lộc 26/08/2026)
   Font: InterVariable. PDF in vẫn Times New Roman A4.
   ============================================================ */

@font-face{font-family:'InterVariable';font-style:normal;font-weight:100 900;font-display:swap;src:url('assets/fonts/InterVariable.woff2') format('woff2')}
@font-face{font-family:'InterVariable';font-style:italic;font-weight:100 900;font-display:swap;src:url('assets/fonts/InterVariable-Italic.woff2') format('woff2')}

:root{
  --bg:#f8f8f8; --bg-gray:#f3f3f3; --surface:#ffffff;
  --border:#ededed; --border-mid:#e2e2e2;
  --text:#171717; --text-mid:#525252; --text-light:#7c7c7c; --placeholder:#999999;
  --control-bg:#f3f3f3;
  --primary:#171717;
  --brand:#ae1c3f;
  --focus-ring:rgba(23,23,23,.12);
  --radius:8px; --radius-lg:12px;
  --shadow-sm:0 1px 2px rgba(0,0,0,.05);
  --shadow-md:0 2px 6px rgba(23,23,23,.06);
  --shadow-lg:0 4px 14px rgba(23,23,23,.08),0 1px 3px rgba(23,23,23,.06);
}
html[data-theme=dark]{
  --bg:#0b0b0d; --bg-gray:#17181a; --surface:#131417;
  --border:#26282c; --border-mid:#33363b;
  --text:#ededed; --text-mid:#a1a4ab; --text-light:#8a8e96; --placeholder:#6b6f77;
  --control-bg:#1c1d21;
  --primary:#ededed;
  --shadow-md:0 2px 6px rgba(0,0,0,.35);
  --shadow-lg:0 4px 16px rgba(0,0,0,.45);
}

*{box-sizing:border-box}
html,body{margin:0;min-height:100%;width:100%;max-width:100%;overflow-x:hidden}
body{
  background:var(--bg); color:var(--text);
  font-family:'InterVariable',Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  font-size:14px; line-height:1.5; -webkit-font-smoothing:antialiased;
}

/* ---------- Login: card trắng kiểu Frappe, nút đỏ Agribank ---------- */
.login-overlay{
  position:fixed; inset:0; z-index:9999;
  display:flex; align-items:center; justify-content:center;
  padding:22px; overflow-y:auto;
  background:
    radial-gradient(circle at 12% 0%,rgba(174,28,63,.07),transparent 34%),
    radial-gradient(circle at 90% 100%,rgba(212,175,55,.06),transparent 30%),
    var(--bg-gray);
}
.auth-panel{
  width:min(400px,92vw); background:var(--surface);
  border:1px solid var(--border); border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg); padding:40px 40px 32px;
  display:grid; gap:12px;
}
.auth-panel .detail-head{display:flex;flex-direction:column;align-items:center;gap:12px;margin-bottom:10px;text-align:center}
.auth-logo{width:64px;height:64px;object-fit:contain;display:block}
.auth-panel h2{margin:0;font-family:inherit;font-size:18px;font-weight:600;letter-spacing:-.01em;color:var(--text);line-height:1.3}
.auth-subtitle{font-size:11px;font-weight:600;color:var(--text-light);text-transform:uppercase;letter-spacing:.08em}
.auth-panel .eyebrow{display:none}
.search-grid.auth-grid{display:grid;grid-template-columns:1fr;gap:12px}
.auth-panel input{
  width:100%;min-height:38px;padding:8px 12px;font-size:14px;font-family:inherit;color:var(--text);
  background:var(--control-bg);border:1px solid transparent;border-radius:var(--radius);outline:none;
  transition:border-color 150ms ease,background-color 150ms ease,box-shadow 150ms ease;
}
.auth-panel input::placeholder{color:var(--placeholder)}
.auth-panel input:focus{background:var(--surface);border-color:var(--border-mid);box-shadow:0 0 0 3px var(--focus-ring)}
.pw-field{position:relative;display:block}
.auth-panel .pw-toggle{
  position:absolute;right:8px;top:50%;transform:translateY(-50%);
  border:none;background:transparent;cursor:pointer;font-family:inherit;
  font-size:11px;font-weight:600;color:var(--text-light);
  padding:4px 6px;border-radius:6px;min-height:24px;
}
.auth-panel .pw-toggle:hover{background:rgba(23,23,23,.06);color:var(--text-mid)}
.login-theme-toggle{justify-self:center;border:1px solid var(--border-mid)!important;background:transparent!important;color:var(--text-mid)!important;font-size:12px!important;min-height:28px!important;padding:2px 10px!important;font-weight:420!important;box-shadow:none!important}
.auth-panel .btn.primary[type="submit"],.auth-panel button.btn.primary{
  width:100%;min-height:36px;border-radius:var(--radius)!important;
  background:var(--brand)!important;color:#fff!important;font-weight:500!important;
  box-shadow:none!important;font-size:13px;
}
.auth-panel .btn.primary:hover{filter:brightness(.9)}
.status{min-height:0;padding:0;border-radius:var(--radius);font-size:12.5px}
.status.info{color:var(--text-light);background:transparent;border:none}
.status.error{
  background:rgba(174,28,63,.08);border:1px solid rgba(174,28,63,.25);
  color:#97183a;padding:8px 12px;font-weight:500;
}
.status.error:empty{display:none}
html[data-theme=dark] .status.error{background:rgba(174,28,63,.18);color:#f0b6c4}

/* ---------- App shell Helpdesk: sidebar + topbar + workspace ---------- */
body{display:grid;grid-template-columns:240px minmax(0,1fr)}
.app-shell{
  grid-column:2;display:block;min-height:100vh;
  max-width:none;margin:0;padding:0;
  background:var(--surface);color:var(--text);
}
.app-shell.locked{visibility:hidden;pointer-events:none}
.hero{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  height:42px;padding:0 14px;margin-bottom:0;border-radius:0;
  background:var(--surface);box-shadow:none;color:var(--text);
  border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:20;width:auto;
}
.hero>div:first-child{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--text-mid);min-width:0}
.hero .eyebrow{display:none}
.hero h1{margin:0;font-family:inherit;font-size:13px;font-weight:600;color:var(--text);letter-spacing:-.01em;line-height:1}
.hero .subtitle{display:none}
.header-right{display:flex;flex-direction:row;align-items:center;gap:8px}

/* ---------- Sidebar trái kiểu Helpdesk ---------- */
.sidebar{
  position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:2px;
  padding:10px;background:var(--bg);border-right:1px solid var(--border);
  overflow-y:auto;z-index:30;width:240px;
}
.brand-block{display:flex;align-items:center;gap:8px;padding:4px 6px 12px}
.brand-logo{width:28px;height:28px;object-fit:contain;flex-shrink:0}
.brand-text{min-width:0}
.brand-name{font-size:13px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brand-user{font-size:11.5px;color:var(--text-light);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.side-section-head{display:flex;align-items:center;justify-content:space-between;padding:8px 6px 4px}
.section-kicker{font-size:11px;font-weight:600;color:var(--text-light);text-transform:uppercase;letter-spacing:.04em}
.side-nav{display:flex;flex-direction:column;gap:2px}
.side-item{
  display:flex;align-items:center;gap:8px;width:100%;height:32px;padding:0 8px;
  font-family:inherit;font-size:13px;font-weight:420;color:var(--text-mid);
  border:none;border-radius:var(--radius);background:transparent;cursor:pointer;text-align:left;
  transition:background-color 150ms ease,color 150ms ease,box-shadow 150ms ease;
}
.side-item svg{width:15px;height:15px;flex-shrink:0;color:var(--text-light)}
.side-item:hover{background:rgba(23,23,23,.05);color:var(--text)}
html[data-theme=dark] .side-item:hover{background:rgba(255,255,255,.06)}
.side-item.active{background:var(--bg-gray);color:var(--text);font-weight:500;box-shadow:var(--shadow-sm);border:1px solid var(--border)}
.side-collapse{margin-top:auto;display:flex;flex-direction:column;gap:6px;padding-top:10px}
.side-btn{width:100%;justify-content:flex-start;padding:4px 8px;font-size:13px}
.side-btn svg{width:15px;height:15px}
.user-badge{background:var(--bg-gray);color:var(--text-mid);padding:2px 8px;border-radius:999px;font-size:13px;font-weight:420;box-shadow:none;white-space:nowrap}

/* Tabs cũ trong topbar — giờ nav nằm sidebar; giữ selector để JS tab vẫn chạy */
.tabs{display:none}

main{
  display:block;
  padding:14px;min-width:0;background:var(--bg);
}
.screen{display:none}
.screen.active{display:block}

/* ---------- Cards & forms ---------- */
.grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(320px,.8fr);gap:14px}
.people-grid{grid-template-columns:minmax(380px,480px) minmax(0,1fr)}
.card{
  background:var(--surface);backdrop-filter:none;
  border:1px solid var(--border);border-radius:var(--radius-lg);
  padding:16px;box-shadow:var(--shadow-md);color:var(--text);
}
.section-title{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:14px}
.section-title h2{margin:0;font-family:inherit;font-size:15px;font-weight:600;color:var(--text)}
.section-title span{color:var(--text-light);font-size:12px;font-weight:420}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:grid;gap:4px;font-weight:500;color:var(--text-mid);font-size:12px}
.full{grid-column:1/-1}
input,select,textarea{
  width:100%;border:1px solid transparent;border-radius:var(--radius);
  padding:6px 8px;min-height:32px;font:inherit;font-size:13px;font-weight:400;
  background:var(--control-bg);color:var(--text);outline:none;
  transition:border-color 150ms ease,background-color 150ms ease,box-shadow 150ms ease;
}
input::placeholder,textarea::placeholder{color:var(--placeholder);opacity:1}
input:focus,select:focus,textarea:focus{background:var(--surface);border-color:var(--border-mid);box-shadow:0 0 0 3px var(--focus-ring)}
textarea{resize:vertical}
.actions{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}
.btn{
  border:0;border-radius:var(--radius);padding:4px 12px;min-height:28px;
  font-family:inherit;font-weight:420;font-size:13px;cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  transition:background-color 150ms ease,filter 150ms ease;
}
.btn:hover{transform:none}
.btn.primary{background:var(--primary);color:var(--surface);box-shadow:none}
.btn.primary:hover{filter:brightness(1.15)}
html[data-theme=dark] .btn.primary:hover{filter:brightness(.88)}
.btn.secondary{background:transparent;color:var(--text);border:1px solid var(--border-mid)}
.btn.secondary:hover{background:rgba(23,23,23,.05)}
html[data-theme=dark] .btn.secondary:hover{background:rgba(255,255,255,.06)}
.btn.danger{background:transparent;color:#b32626;border:1px solid rgba(179,38,38,.35)}
.btn.danger:hover{background:rgba(179,38,38,.07)}

/* ---------- Preview / records / people ---------- */
.mini-preview{font-size:13px;line-height:1.6;background:var(--bg-gray);border:1px solid var(--border);border-radius:var(--radius-lg);padding:12px;color:var(--text)}
.mini-preview b{color:var(--text)}
.preview-bullet{color:var(--brand)}
.records-list,.people-list{display:grid;gap:8px}
.record-item,.person-item{
  display:grid;gap:8px;padding:10px 12px;
  border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);color:var(--text);
}
.person-item{grid-template-columns:minmax(0,1fr) auto;align-items:center}
.record-meta,.person-meta{color:var(--text-light);font-size:12px}
.record-goods{color:var(--text-mid);font-size:13px}
.role-badge{display:inline-flex;padding:1px 9px;border-radius:999px;background:rgba(174,28,63,.09);color:var(--brand);font-size:11px;font-weight:600;margin-left:8px}
.item-actions{display:flex;gap:6px;flex-wrap:wrap}
.item-actions button{padding:2px 9px;border-radius:var(--radius);min-height:26px;font-size:12px}
.record-toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.record-toolbar input,.record-toolbar select{width:auto;min-width:150px;flex:1 1 160px}
.backend-hint{color:var(--text-light);font-size:12px;font-weight:500}

/* Goods builder */
.goods-builder{border:1px solid var(--border);border-radius:var(--radius-lg);padding:12px;background:var(--bg-gray)}
.goods-head{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:10px}
.goods-head h3{margin:0;font-family:inherit;font-size:14px;font-weight:600;color:var(--text)}
.goods-note{color:var(--text-light);font-size:12px;font-weight:420}
.goods-grid{display:grid;gap:10px}
.goods-card{border:1px solid var(--border);border-radius:var(--radius-lg);background:var(--surface);overflow:hidden}
.goods-main{display:flex;align-items:center;gap:10px;padding:9px 12px;background:var(--bg-gray);font-weight:500;color:var(--text);font-size:13px}
.goods-main input{width:auto}
.goods-body{display:none;padding:12px;border-top:1px solid var(--border)}
.goods-card.active .goods-body{display:block}
.detail-row{display:grid;grid-template-columns:minmax(140px,1fr) 150px 64px;gap:8px;align-items:end;margin-bottom:8px}
.detail-check{display:flex;flex-direction:row;align-items:center;gap:6px;font-weight:500;color:var(--text-mid);font-size:12px}
.detail-check input{width:auto}
.unit-pill{align-self:center;justify-self:start;padding:2px 10px;border-radius:999px;background:var(--bg-gray);border:1px solid var(--border);color:var(--text-mid);font-weight:600;font-size:11px}
.manual-area{display:grid;gap:8px}
.manual-area textarea{min-height:74px}
.money-note{color:var(--text-light);font-size:12px;margin-top:6px}

/* ---------- Print paper: GIỮ NGUYÊN Times New Roman A4 ---------- */
.print-paper{background:white;width:210mm;min-height:297mm;margin:24px auto;padding:20mm 25mm;color:#000;font-family:"Times New Roman",serif;font-size:16pt;line-height:1.32;box-shadow:0 20px 60px rgba(15,23,42,.12)}
.print-paper .doc-header{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:18pt;font-size:12pt;text-align:center}
.print-paper .doc-left,.print-paper .doc-right{display:flex;flex-direction:column;align-items:center}
.print-paper .doc-left p,.print-paper .doc-right p{margin:0;line-height:1.2}
.print-paper .doc-no{margin-top:8pt;font-size:15pt}
.print-paper .nowrap{white-space:nowrap}
.print-paper .doc-left p{white-space:nowrap}
.print-paper .doc-left{font-size:11.5pt}
.print-paper .header-rule{width:120px;height:0;border-bottom:1px solid #000;margin:4pt 0}
.print-paper .date-line{margin-top:8pt;font-size:15pt}
.print-paper h1{text-align:center;font-size:17pt;font-weight:bold;font-style:normal;margin:12pt 0 0;line-height:1.2}
.print-paper h2{text-align:center;font-size:17pt;font-weight:bold;margin:3pt 0 14pt;line-height:1.2}
.print-paper p{margin:0 0 6pt;text-align:left}
.print-paper .center{text-align:center}
.print-paper .justify{text-align:justify}
.print-paper .indent{text-indent:1cm}
.print-paper .decision{margin:10pt 0}
.print-paper .bold{font-weight:bold}
.print-paper .italic{font-style:italic}
.print-paper .sign{display:grid;grid-template-columns:1fr 1fr;margin-top:8pt;gap:20px;line-height:1.15}
.print-paper .sign p{margin:0 0 1pt}
.print-paper .right{text-align:center;transform:translateX(28mm)}
.print-paper .small{font-size:11pt}
.print-paper .goods-line{margin:0 0 0 1.5cm;text-indent:0}
.print-paper .goods-heading{margin-left:1cm}
.print-paper .goods-empty{color:#111}
body.printing-record .no-print{display:none!important}
body.printing-record .card{display:block!important}

@media print{
  body{background:white}
  .no-print,.card,.login-overlay,.hero{display:none!important}
  .app-shell{display:block;padding:0;max-width:none;background:white}
  main{padding:0;background:white}
  .screen{display:none}
  body.printing-record #printArea,main .screen.active .print-paper{display:block}
  .print-paper{display:block;box-shadow:none;margin:0;width:auto;min-height:auto;padding:0;font-size:15pt}
  @page{size:A4;margin:20mm 15mm 20mm 25mm}
}

/* ---------- Page Break Rules for PDF Print ---------- */
.fund14-page{page-break-before:always;break-before:page;font-family:"Times New Roman",Times,serif;color:#000;background:#fff;margin-top:20px;padding:20mm 20mm 20mm 25mm;font-size:17pt;line-height:1.33;min-height:297mm;position:relative}.fund14-page p{margin:0 0 6pt}.fund14-header{display:grid;grid-template-columns:1fr 1.12fr;gap:10mm;text-align:center;align-items:start}.fund14-left,.fund14-right{font-size:13.5pt;line-height:1.2;text-align:center}.fund14-left p,.fund14-right p{text-align:center!important}.fund14-rule{width:42mm;border-top:1px solid #000;margin:3pt auto 6pt}.fund14-title{text-align:center;font-size:17pt!important;line-height:1.15!important;margin:20pt 0 12pt!important;font-weight:700;white-space:nowrap}.fund14-kg,.fund14-p,.fund14-line{margin-left:12mm!important;text-indent:0!important}.fund14-p,.fund14-line,.fund14-sub{font-size:16pt!important;line-height:1.34!important}.fund14-sub{margin-left:20mm!important}.fund14-sign{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8mm;text-align:center;margin-top:18pt;font-size:13.5pt;line-height:1.2}.fund14-sign p{font-size:13.5pt!important;margin:0 0 3pt!important}

@media print{.fund14-page{margin:0!important;padding:0!important;min-height:auto!important;font-size:17pt!important;line-height:1.33!important;page-break-before:always!important;break-before:page!important}.print-paper .fund14-page p{font-size:17pt!important;line-height:1.33!important;margin-bottom:6pt!important}.print-paper .fund14-left,.print-paper .fund14-right{font-size:13.5pt!important;text-align:center!important}.print-paper .fund14-left p,.print-paper .fund14-right p{font-size:13.5pt!important;line-height:1.2!important;text-align:center!important}.print-paper .fund14-left p:last-child,.print-paper .fund14-right p:last-child{font-size:17pt!important;line-height:1.33!important;text-align:center!important}.print-paper .fund14-title{font-size:17pt!important;line-height:1.15!important;white-space:nowrap!important}.print-paper .fund14-kg,.print-paper .fund14-p,.print-paper .fund14-line{margin-left:12mm!important;text-indent:0!important;font-size:17pt!important}.print-paper .fund14-sub{margin-left:20mm!important;font-size:17pt!important}.print-paper .fund14-sign p{font-size:13.5pt!important}}

.proposal-page{page-break-before:always;break-before:page;font-family:"Times New Roman",Times,serif;color:#000;background:#fff;margin-top:20px;padding:18mm 18mm 18mm 22mm;font-size:15pt;line-height:1.28;box-sizing:border-box}
.proposal-title{text-align:center!important;font-size:18pt!important;font-weight:700!important;margin:12pt 0 0!important;letter-spacing:.2px}
.proposal-subtitle{text-align:center!important;font-size:16pt!important;font-weight:700!important;margin:0 0 12pt!important;line-height:1.25!important}
.proposal-section-title{font-weight:700!important;margin:8pt 0 4pt!important;text-indent:0!important;font-size:15pt!important}
.proposal-unit{text-align:right!important;font-style:italic!important;font-size:13pt!important;margin:0 0 2pt!important}
.proposal-table{width:100%;border-collapse:collapse;margin:4pt 0 8pt;font-size:13pt!important;line-height:1.2!important}
.proposal-table th,.proposal-table td{border:1px solid #000;padding:3pt 4pt;text-align:center;vertical-align:middle;font-size:13pt!important;line-height:1.2!important}
.proposal-table th{font-weight:700!important}
.proposal-table td:nth-child(2){text-align:left!important}
.money-table td:nth-child(4){font-style:italic;text-align:left!important}
.proposal-sign{width:48%;margin-left:auto;text-align:center;margin-top:18pt;font-size:14pt!important}
@media print{.proposal-page{margin:0!important;padding:0!important;font-size:15pt!important;line-height:1.28!important;page-break-before:always!important;break-before:page!important}.proposal-title{font-size:18pt!important}.proposal-subtitle{font-size:16pt!important}.proposal-table th,.proposal-table td{font-size:13pt!important}}

.intro-page{page-break-before:always;break-before:page;font-family:"Times New Roman",Times,serif;color:#000;background:#fff;margin-top:20px;padding:20mm 20mm 20mm 25mm;font-size:17pt;line-height:1.35;min-height:297mm;box-sizing:border-box}
@media print{.intro-page{margin:0!important;padding:0!important;min-height:auto!important;font-size:17pt!important;line-height:1.35!important;page-break-before:always!important;break-before:page!important}.intro-page p{font-size:17pt!important;line-height:1.35!important}.intro-title{font-size:21pt!important}.intro-sign p{font-size:17pt!important}}

/* ---------- Responsive ---------- */
@media(max-width:1100px){
  body{display:block}
  .sidebar{position:static;height:auto;width:auto;border-right:none;border-bottom:1px solid var(--border)}
  .side-collapse{flex-direction:row;padding-top:8px}
  .hero{height:auto;min-height:42px;flex-wrap:wrap;padding:8px 10px;gap:8px}
  .grid,.people-grid{grid-template-columns:minmax(0,1fr)}
}
@media(max-width:900px){
  .hero{position:static}
  .two-col{grid-template-columns:minmax(0,1fr)}
  .detail-row{grid-template-columns:minmax(0,1fr)}
  .unit-pill{justify-self:stretch;text-align:center}
  .print-paper{width:100%;padding:18px}
  .record-toolbar input,.record-toolbar select{flex:1 1 130px}
}
