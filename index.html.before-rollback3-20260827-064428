<!doctype html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>In lệnh điều chuyển hàng đặc biệt</title>
  <script>document.documentElement.dataset.theme=localStorage.getItem('transferOrder.theme.v1')||'light'</script>
  <link rel="preload" href="assets/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="assets/img/logo_agribank.png">
  <link rel="stylesheet" href="styles.css?v=20260827-hd3">
</head>
<body class="auth-pending">
<section id="loginOverlay" class="login-wrap auth-panel-wrap">
  <section id="authSection" class="panel auth-panel">
    <div class="detail-head">
      <img class="auth-logo" src="assets/img/logo_agribank.png" alt="Agribank">
      <h2 class="auth-title">Đăng nhập Agribank Thanh Hóa</h2>
      <div class="auth-subtitle">IN LỆNH ĐIỀU CHUYỂN</div>
    </div>
    <form id="loginForm" class="search-grid auth-grid" autocomplete="on">
      <input id="loginUsername" name="username" autocomplete="username" autocapitalize="none" placeholder="Email hoặc User LDAP" required>
      <div class="pw-field">
        <input id="loginPassword" name="password" type="password" autocomplete="current-password" placeholder="Mật khẩu" required>
        <button type="button" class="pw-toggle" data-pw-toggle aria-label="Hiện mật khẩu">Hiện</button>
      </div>
      <p id="loginError" class="status error" role="alert"></p>
      <button class="btn primary login-submit">Đăng nhập</button>
    </form>
    <button class="side-collapse auth-theme-btn" type="button" data-theme-toggle aria-label="Chuyển giao diện sáng/tối">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="15" height="15"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.3 11.3 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.3-11.3 1.4-1.4"/></svg>
      Giao diện
    </button>
  </section>
</section>
<div id="appShell" class="app-shell locked">
  <aside class="sidebar">
    <div class="brand-block">
      <img class="brand-logo" src="assets/img/logo_agribank.png" alt="Brand Logo">
      <span><span class="brand-name">Lệnh điều chuyển</span><span class="brand-user">Agribank Thọ Xuân</span></span>
    </div>
    <div class="side-section-head">
      <div><p class="section-kicker">HỒ SƠ</p><h2>Điều chuyển</h2></div>
      <button class="tool-btn" id="refreshRecordsBtn" type="button" title="Tải lại danh sách" aria-label="Tải lại danh sách">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="14" height="14"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"/><path d="M21 3v5h-5"/></svg>
      </button>
    </div>
    <input id="recordSearch" type="search" placeholder="Tìm bản ghi...">
    <nav class="side-nav">
      <button class="side-item active" data-screen="formScreen">Lập lệnh</button>
      <button class="side-item" data-screen="recordsScreen">Bản ghi đã lưu</button>
      <button class="side-item" data-screen="peopleScreen">Quản lý nhân sự</button>
    </nav>
    <button class="side-collapse" type="button" data-theme-toggle aria-label="Đổi giao diện">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="15" height="15"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.3 11.3 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.3-11.3 1.4-1.4"/></svg>
      Giao diện
    </button>
  </aside>
  <div class="main-col">
    <header class="topbar">
      <div class="crumb">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:1.7"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        <span class="crumb-current">Điều chuyển</span>
        <span>/ Hồ sơ</span>
      </div>
      <div class="user">
        <span id="currentUserName" class="user-badge"></span>
        <button id="logoutBtn" class="secondary">Đăng xuất</button>
        <button class="cta-new" data-screen="formScreen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="stroke-width:2.2"><path d="M12 5v14M5 12h14"/></svg>
          Tạo lệnh
        </button>
      </div>
    </header>
    <main class="workspace-col">
      <section id="formScreen" class="screen">
        <div class="grid form-grid">
          <form id="orderForm" class="card form-card">
            <div class="section-title">
              <div><p class="section-kicker">THÔNG TIN LỆNH</p><h2 style="font-size:15px">Thông tin lệnh</h2></div>
              <span class="hd-span">Nháp</span>
            </div>
            <div class="two-col">
              <label>Nơi đi<select id="fromBranch" required></select></label>
              <label>Nơi đến<select id="toBranch" required></select></label>
              <label>Biển số xe<input id="vehiclePlate" placeholder="VD: 36A-708.79"></label>
              <label>Số văn bản<input id="docNo" placeholder="          /QĐ-NHNo.TX-KTNQ"></label>
              <label>Ngày văn bản<input id="docDate" type="date"></label>
              <label>Người áp tải<select id="escortId" required></select></label>
              <label>Lái xe<select id="driverId" required></select></label>
              <label>Bảo vệ<select id="guardId" required></select></label>
              <label>Người đề nghị<select id="requesterId"></select></label>
              <label>Người nhập<select id="receiverId"></select></label>
              <div class="full goods-builder" id="goodsBuilder"></div>
            </div>
            <div class="actions">
              <button type="button" id="resetOrderBtn" class="secondary">Làm mới</button>
              <button type="button" id="printBtn" class="primary">In lệnh</button>
            </div>
          </form>
          <aside class="card preview-card">
            <div class="section-title">
              <div><p class="section-kicker">XEM TRƯỚC</p><h2 style="font-size:15px">Tóm tắt lệnh</h2></div>
              <span class="hd-span">Live</span>
            </div>
            <div id="miniPreview" class="mini-preview"></div>
          </aside>
        </div>
        <article id="printArea" class="print-paper"></article>
      </section>
      <section id="recordsScreen" class="screen">
        <div class="card records-card">
          <div class="section-title">
            <div><p class="section-kicker">HỒ SƠ</p><h2 style="font-size:15px">Bản ghi đã lưu</h2></div>
            <span id="recordsCount" class="hd-span">0 bản ghi</span>
          </div>
          <div class="record-toolbar record-toolbar-filters">
            <input id="recordSearch2" placeholder="Tìm số văn bản, nơi đi, nơi đến...">
            <input id="recordFromDate" type="date" title="Từ ngày">
            <input id="recordToDate" type="date" title="Đến ngày">
            <select id="recordEscortFilter"><option value="">Tất cả người áp tải</option></select>
            <select id="recordUserFilter"><option value="">Tất cả user lập lệnh</option></select>
            <button type="button" id="refreshRecordsBtn2" class="secondary">Tải lại</button>
          </div>
          <div id="recordsList" class="records-list"></div>
        </div>
      </section>
      <section id="peopleScreen" class="screen">
        <div class="grid people-grid">
          <form id="personForm" class="card form-card">
            <div class="section-title">
              <div><p class="section-kicker">NHÂN SỰ</p><h2 style="font-size:15px">Thêm / sửa nhân sự</h2></div>
              <span id="editBadge" class="hd-span">Thêm mới</span>
            </div>
            <input type="hidden" id="personId">
            <div class="two-col">
              <label>Họ tên<input id="personName" required placeholder="VD: Đỗ Tuấn Minh"></label>
              <label>Vai trò<select id="personRole"><option value="escort">Người áp tải</option><option value="driver">Lái xe</option><option value="guard">Bảo vệ</option><option value="requester">Người đề nghị</option><option value="receiver">Người nhập</option></select></label>
              <label>Chức vụ<input id="personTitle" required placeholder="VD: Trưởng phòng KTNQ"></label>
              <label>Giới tính / xưng hô<select id="personGender"><option value="Ông">Ông</option><option value="Bà">Bà</option></select></label>
              <label>Số CCCD<input id="personCccd" maxlength="12" placeholder="12 số"></label>
              <label>Ngày cấp<input id="personIssueDate" placeholder="DD/MM/YYYY"></label>
              <label>Nơi cấp<input id="personIssuePlace" placeholder="Cục CSQLHC về TTXH"></label>
              <label>User<input id="personUser" placeholder="VD: THXLXUAN"></label>
            </div>
            <div class="actions">
              <button type="button" id="resetPersonBtn" class="secondary">Làm mới</button>
              <button class="primary">Lưu nhân sự</button>
            </div>
          </form>
          <div class="card list-card">
            <div class="section-title">
              <div><p class="section-kicker">DANH SÁCH</p><h2 style="font-size:15px">Nhân sự</h2></div>
              <span id="peopleCount" class="hd-span"></span>
            </div>
            <div id="peopleList" class="people-list"></div>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
<script src="app.js?v=20260812-acqt-introduction-always"></script>

<script>
(function(){
  var sels='.tab,.side-item';
  function sync(btn){
    var target=btn.getAttribute('data-screen');
    if(!target) return;
    document.querySelectorAll(sels+',.screen').forEach(function(x){x.classList.remove('active');});
    document.querySelectorAll('.side-item[data-screen="'+target+'"]').forEach(function(x){x.classList.add('active');});
    var scr=document.getElementById(target);
    if(scr) scr.classList.add('active');
  }
  document.querySelectorAll(sels).forEach(function(btn){
    var orig=btn.onclick;
    btn.addEventListener('click',function(ev){sync(btn);});
  });
})();
</script></body></html>